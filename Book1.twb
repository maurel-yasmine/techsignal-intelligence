      <aliases enabled='yes' />
      <column caption='Freshness Age (Hours)' datatype='integer' name='[Calculation_0819190362722306]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='DATEDIFF(&apos;hour&apos;, [freshness_timestamp], NOW())' />
      </column>
      <column caption='Invalif AI Rate' datatype='real' default-format='p0.00%' name='[Calculation_0819190365646851]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[invalid_ai_count] / [total_bronze_rows]' />
      </column>
      <column caption='Data Loss Rate' datatype='real' default-format='p0.00%' name='[Calculation_0819190366052356]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='([deleted_dead_count] + [quarantine_count]) / [total_bronze_rows]' />
      </column>
